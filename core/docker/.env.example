# FEIT CTF - Environment Variables Template
# Copy this file to .env and fill in the values

# Scoreboard Settings
SCOREBOARD_SECRET_KEY=yoursecretkeyhere
ADMIN_PASSWORD=adminpasswordhere

# Team 1
TEAM1_VNC_PASS=team1vncpass
TEAM1_WEB_SOURCE_FLAG=FEIT{team1_web_source_flag_placeholder}
TEAM1_WEB_HEADER_FLAG=FEIT{team1_web_header_flag_placeholder}
TEAM1_SQLI_FLAG=FEIT{team1_sqli_flag_placeholder}
TEAM1_HIDDEN_FTP_FLAG=team1_ftp_flag_hex_placeholder
TEAM1_HIDDEN_WEB_FLAG=team1_web_flag_hex_placeholder
TEAM1_HIDDEN_WEB_HMAC_FLAG=FEIT{team1_hmac_flag_placeholder}
TEAM1_PCAP_HTTP_FLAG=FEIT{team1_pcap_http_flag_placeholder}
TEAM1_PCAP_DNS_FLAG=FEIT{team1_pcap_dns_flag_placeholder}
TEAM1_REDIS_FLAG=FEIT{team1_redis_flag_placeholder}
